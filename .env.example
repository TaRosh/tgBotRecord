# Токен бота от @BotFather (обязательно)
BOT_TOKEN=

# Telegram ID мастера/администратора (обязательно). Узнать: @userinfobot
ADMIN_ID=

# Часовой пояс, в котором мастер ведёт запись
TIMEZONE=Europe/Moscow

# Путь к файлу SQLite
DB_PATH=data/bot.db

# Уровень логов: debug | info | warn | error
LOG_LEVEL=info
